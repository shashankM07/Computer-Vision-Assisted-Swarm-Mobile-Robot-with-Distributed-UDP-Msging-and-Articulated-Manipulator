Code for testing shoulder and elbow joints of the robotic arm

#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>

// Initialize the PCA9685 at the default I2C address (0x40)
Adafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver();

// MG996R Pulse Width Calibration (Adjust these if your servos buzz at the limits)
const int SERVOMIN = 150; // Minimum pulse length count (out of 4096)
const int SERVOMAX = 600; // Maximum pulse length count (out of 4096)

const int SHOULDER_PORT = 0;
const int ELBOW_PORT = 1;

void setup() {
  Serial.begin(115200);
  Serial.println("Robotic Arm Servo Test Initialized.");

  pwm.begin();
  pwm.setOscillatorFrequency(27000000); // Standard PCA9685 internal oscillator
  pwm.setPWMFreq(50); // Analog servos run at 50 Hz
  
  delay(10);
}

// Helper function to map degrees (0-180) to PWM pulses
void moveServo(uint8_t port, int degree) {
  int pulse = map(degree, 0, 180, SERVOMIN, SERVOMAX);
  pwm.setPWM(port, 0, pulse);
  Serial.printf("Port %d moved to %d degrees.\n", port, degree);
}

void loop() {
  Serial.println("Moving to Home Position (90 degrees)...");
  moveServo(SHOULDER_PORT, 90);
  moveServo(ELBOW_PORT, 90);
  delay(2000);

  Serial.println("Sweeping Shoulder to 135 degrees...");
  moveServo(SHOULDER_PORT, 135);
  delay(1000);
  
  Serial.println("Sweeping Elbow to 45 degrees...");
  moveServo(ELBOW_PORT, 45);
  delay(1000);

  Serial.println("Returning to Home Position...");
  moveServo(SHOULDER_PORT, 90);
  moveServo(ELBOW_PORT, 90);
  delay(2000);
}
